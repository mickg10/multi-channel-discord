#!/usr/bin/env bun
/**
 * agent-bus-grant — issue, list or revoke MCP grants in a router state dir.
 * Run on the router host (or wherever the state dir is mounted). Round one issues none;
 * this CLI exists for round two, when a side-effecting server is declared and Mick approves.
 *
 *   bun bin/agent-bus-grant <stateDir> issue <server> [--session <name>] [--instance <id>] [--ttl-hours N] [--note "..."]
 *   bun bin/agent-bus-grant <stateDir> list
 *   bun bin/agent-bus-grant <stateDir> revoke <grantId>
 */

import { Grants } from '../src/mcp.js'

const [stateDir, cmd, ...rest] = process.argv.slice(2)
if (!stateDir || !cmd || !['issue', 'list', 'revoke'].includes(cmd)) {
  process.stderr.write('usage: bun bin/agent-bus-grant <stateDir> issue <server> [--session <name>] [--instance <id>] [--ttl-hours N] [--note "..."] | list | revoke <grantId>\n')
  process.exit(2)
}

const grants = Grants.inStateDir(stateDir)

if (cmd === 'list') {
  const all = grants.list()
  if (!all.length) console.log('no grants')
  for (const g of all) console.log(`${g.id}  server=${g.server}${g.session ? `  session=${g.session}` : ''}${g.instance ? `  instance=${g.instance}` : ''}  expires=${g.expires}${g.note ? `  (${g.note})` : ''}`)
  process.exit(0)
}

if (cmd === 'revoke') {
  const id = rest[0]
  if (!id) { process.stderr.write('revoke needs a grant id\n'); process.exit(2) }
  console.log(grants.revoke(id) ? `revoked ${id}` : `unknown grant ${id}`)
  process.exit(0)
}

// issue
const server = rest[0]
if (!server) { process.stderr.write('issue needs a server name\n'); process.exit(2) }
const opts: { session?: string; instance?: string; ttlHours?: number; note?: string } = {}
for (let i = 1; i < rest.length; i++) {
  const flag = rest[i], value = rest[++i]
  if (flag === '--session') opts.session = value
  else if (flag === '--instance') opts.instance = value
  else if (flag === '--ttl-hours') opts.ttlHours = Number(value)
  else if (flag === '--note') opts.note = value
}
console.log(JSON.stringify(grants.issue(server, opts), null, 2))
